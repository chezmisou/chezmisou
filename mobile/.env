# Supabase : URL du projet (format https://xxxx.supabase.co) et clé publique.
# Tant que l'URL n'est pas renseignée, l'app récupère la config auprès du site.
# EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_cfETOxyGge0oa83AGL1EZg_K7i8tibg
