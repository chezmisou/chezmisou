{
  "expo": {
    "name": "Chez Misou",
    "slug": "chez-misou",
    "scheme": "chezmisou",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8EE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chezmisou.app"
    },
    "android": {
      "package": "com.chezmisou.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FFF8EE"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Chez Misou utilise vos photos pour illustrer les plats du menu."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://chezmisou.com"
    }
  }
}
